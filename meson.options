option('gdb_debugging', type : 'boolean', value : false)
option('logging_enabled', type: 'boolean', value: false)
option('autoplay_tests', type: 'boolean', value: false, description: 'Build the isolated Linux story-test bridge')
option('build_target', type: 'combo', choices: ['linux', 'win64'], value: 'linux', description: 'Target build platform')
option('tracy_enable' , type : 'boolean' , value : false, description : 'Enable Tracy profiling')
option('skip_anim_scripts', type : 'boolean', value : false, description : 'True to skip building anim scripts' )
option('sanitize', type: 'boolean', value: false, description: 'PC builds: AddressSanitizer + UBSan everywhere (make linux-asan)')
option('port_werror', type: 'boolean', value: false, description: 'PC builds: treat warnings in src/port and src/bwbattle as errors')
